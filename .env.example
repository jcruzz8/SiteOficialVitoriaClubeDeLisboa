# Arquivo de exemplo das variáveis de ambiente necessárias
# Copie este arquivo para .env e preencha com os valores reais

# Chave de API do Web3Forms (obtenha em https://web3forms.com/)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Senha para acessar a área de administração
VITE_ADMIN_PASSWORD=your_admin_password_here

# URLs públicas do Google Sheets (links de compartilhamento público)
VITE_GOOGLE_SHEETS_JOGOS=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=0&single=true&output=csv
VITE_GOOGLE_SHEETS_TABELA=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=YOUR_GID&single=true&output=csv
VITE_GOOGLE_SHEETS_PLANTEL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=YOUR_GID&single=true&output=csv
VITE_GOOGLE_SHEETS_EDICAO=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit?usp=sharing